# ── Google 試算表（網站公開內容管理表）──────────────────────────
# 試算表網址 https://docs.google.com/spreadsheets/d/<這一段>/edit 中的 ID。
# 這份試算表只能放「允許公開」的內容，絕不可與報名主表、保險名冊、健康紀錄放在同一份檔案。
# 未設定時，網站使用 content/seed/ 內建的已核實資料。
GOOGLE_SHEET_ID=

# 試算表資料快取秒數（ISR）。協會改完試算表後，最晚這麼久會反映到網站。
CONTENT_REVALIDATE_SECONDS=300

# 預覽模式：true 時，「肖像授權＝待確認」的照片也會顯示（加上預覽標記），且整站 noindex。
# 正式公開網站必須設為 false 或不設定。
SITE_PREVIEW_MODE=false

# 資料檢核頁 /cms-check?token=... 的通行碼。未設定則該頁停用。
CMS_CHECK_TOKEN=

# 網站正式網址（產生 sitemap / 分享連結用），例如 https://keelung-ocean.example.org
NEXT_PUBLIC_SITE_URL=
